-extends "channels/channel_claim_number.html"

-load compress temba
-load i18n

-block account-trial-warning
  -if account_trial
    .alert-warning.my-4
      - blocktrans trimmed
        You've connected a Twilio trial account, which has some restrictions.

      .mt-2
        %a(href="https://www.twilio.com/help/faq/twilio-basics/how-does-twilios-free-trial-work")
          -trans "Read more about the limits placed on Twilio's free trial numbers."


-block numbers-search-form


-block claim-numbers-description
  -blocktrans trimmed
    Once you connect a number, you'll immediately be able to send and receive WhatsApp messages.

  -if not account_numbers
    .alert-warning.my-4
      - blocktrans trimmed
        You don't have any numbers on your Twilio account. Make sure you have a number with access to Twilio WhatsApp.

      .mt-2
        %a(href="https://www.twilio.com/whatsapp/request-access")
          - trans "To request access to Twilio WhatsApp"
