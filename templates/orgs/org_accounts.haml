-extends 'smartmin/form.html'
-load smartmin temba compress i18n

-block pre-form
  -if not use_weni_layout
    .mb-2
      -blocktrans trimmed
        Your workspace can have logins with various roles. You can use the Manage Logins page to view all existing
        logins or add new ones.
    
    .inline-block
      .button-light(onclick="goto(event)" href="{%url 'orgs.org_manage_accounts'%}")
        -trans "Manage logins"

    .mt-8

    .mb-3
      -blocktrans trimmed with brand=brand.name
        If you use the {{ brand }} Surveyor app to run flows offline, we recommend enabling users to create accounts
        from the Android app. Setting a Surveyor password will allow anyone with that password to join your workspace
        as a surveyor.

-block summary
  -if not use_weni_layout
    -trans "Your workspace has"
    {% for role in role_summary %}{{ role }}{{ forloop|oxford }}{% endfor %}.
