-extends 'includes/modal.html'
-load i18n temba

-block modal
  {{block.super}}
    
  -with flows=object.dependent_flows.all
    -if flows
      -blocktrans count counter=flows|length
        There's an active flow using this flow. It can't be deleted until it's removed from the
      
      -plural
        There are {{counter}} active flows using this flow. It can't be deleted until it's removed from the

      -for flow in flows
        <a href="{%url 'flows.flow_editor' flow.uuid%}">{{flow.name}}</a>{{forloop|oxford}}
      
      -blocktrans count counter=flows|length
        flow.
      -plural
        flows.
    -else
      -blocktrans
        You're about to delete
        %span.font-normal
          {{object}}.
        This action can't be undone. Are you sure you want to continue?
      
      .hidden
        %form(method="POST")
          %input(type="submit" value="{{submit_button_name}}")
