-extends "flows/flow_editor.html"
-load compress temba i18n

-block extra-style
  {{block.super}}
  :css
    .spa-container {
      padding: 0;
    }

    .spa-title {
      margin: 0em;
      border-radius: 0;
    }

    #rp-flow-editor {
      
    }

    .more .submenu {
      top: 2.5em !important;
      right: 0.5em !important;
    }

    #rp-flow-editor #simulator {
      top: 20px !important;
      right: 1em;
    }


    #canvas-container > div, #canvas:after {
      
    }

    #grid {
      overflow-y: auto;
      z-index: 0;
    }

    #simulator-tab {
      margin-right: 17px;
    }

    #poptab {
      margin-left: -17px;
    }

    .menu {
      margin-top: 0.5rem;
    }


-block alert-messages
  -if is_starting or messages or user_org.is_suspended
    .pt-5.pr-5.pl-5
      {{block.super}}
      -if is_starting
        %temba-alert.mb-3
          -blocktrans trimmed
            This flow is being sent. This message will disappear once all contacts have been added to the flow.

-block page-container

  %temba-modax#send-message-modal{ header:"Send Message" }

  %temba-dialog.hide#confirm-language(header='{{_("Change language")|escapejs}}' primaryButtonName='{{_("Update")|escapejs}}')
    .p-6.body
      -blocktrans trimmed with language="%LANG%"
        This will change the default language of the flow to <b>{{ language }}</b>. The flow will appear in that
        language by default and can be translated into other languages. If a contact is in this flow and no
        translation exists for their language or the workspace's default language, communication with that contact
        will default to <b>{{ language }}</b>.

  #grid
    <temba-loading units="10" size="8"></temba-loading>
    #rp-flow-editor