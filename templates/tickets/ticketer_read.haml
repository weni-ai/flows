-extends "smartmin/read.html"
-load smartmin i18n

-block pjax
  -blocktrans trimmed with type_name=object.type.name name=object.name
    {{ type_name }} ticketing service over <b>{{ name }}</b>. Contacts with open tickets for this service will have
    their messages forwarded to the service, and replies will be sent back to the contact.

  .buttons.mt-5
    -if org_perms.request_logs.httplog_list
      .button-light.mr-3(onclick='goto(event)' href='{% url "request_logs.httplog_ticketer" object.uuid %}')
        -trans "HTTP log"
    -if org_perms.tickets.ticketer_delete
      %temba-modax(endpoint="{% url 'tickets.ticketer_delete' object.uuid %}" header='{% trans "Delete ticketing service" %}')
        .button-light
          -trans "Remove"


-block summary
  -blocktrans trimmed with type_name=object.type.name name=object.name
    {{ type_name }} ticketing service over <b>{{ name }}</b>
