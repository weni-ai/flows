-extends "smartmin/read.html"
-load smartmin i18n

-block title
  .medium-help.float-left(class='{{ object.type.icon }}')

  %h2.font_normalize.header-margin.title
    {{ ticketer.type.name }}
    -trans "Ticketing service"
    .ticketer-name
      {{ ticketer.name }}

-block content
  -blocktrans trimmed
    To finish connecting your account to Zendesk, complete the following steps.

  %ol.steps.card
    %li
      -blocktrans trimmed with brand=brand.name
        Install the {{ brand }} app into your Zendesk account from the <a href="{{ market_url }}">marketplace</a>.
    %li
      -blocktrans trimmed  with brand=brand.name
        Go to <a href="{{ channels_url }}">channel integrations</a> where you'll see a new {{ brand }} channel
        service.
    %li
      -blocktrans trimmed with secret=object.config.secret
        Add an account for the channel and enter <code>{{ secret }}</code> as the secret.

-block extra-style
  {{ block.super }}

  :css
    .ticketer-name {
      font-size: 16pt;
    }
