#, python-format
msgid "If you have a %(link)s number, you can quickly connect it using their APIs."
msgstr "Si tienes un número %(link)s, puedes conectarlo rápidamente usando sus APIs."

msgid "To finish connecting your channel, you'll need to set your callback URLs below for your number."
msgstr "Para terminar de conectar tu canal, debes configurar las callback URLs a continuación para tu número."

msgid "This URL should be called by BurstSMS when new messages are received. You must set this for your number under the 'Inbound Settings' options. Select 'Yes' for the 'Forward to URL' option and enter this URL."
msgstr "BurstSMS debe llamar a esta URL cuando se reciban nuevos mensajes. Debes configurarla para tu número en las opciones de 'Inbound Settings'. Selecciona 'Yes' para la opción 'Forward to URL' e ingresa esta URL."

msgid "DLR callback URL"
msgstr "Callback URL de DLR"

msgid "This URL should be called by BurstSMS when the status of an outgoing message is updated. You can set it on the settings page."
msgstr "BurstSMS debe llamar a esta URL cuando se actualice el status de un mensaje saliente. Puedes agregarla en la página de configuración."

msgid "Reply callback URL"
msgstr "Callback URL de respuesta"

msgid "This URL should be called by BurstSMS when messages are replied to. You can set it on the settings page."
msgstr "BurstSMS debe llamar a esta URL cuando se responda a los mensajes. Puedes agregarla en la página de configuración."

