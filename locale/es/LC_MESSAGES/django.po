#, python-format
msgid "If you have a %(link)s number, you can quickly connect it using their APIs."
msgstr "Si tienes un número %(link)s, puedes conectarlo rápidamente usando sus APIs."

msgid "To finish connecting your channel, you'll need to set your callback URLs below for your number."
msgstr "Para terminar de conectar tu canal, debes configurar las URL de Callback a continuación para tu número."

msgid "This URL should be called by BurstSMS when new messages are received. You must set this for your number under the 'Inbound Settings' options. Select 'Yes' for the 'Forward to URL' option and enter this URL."
msgstr "Esta URL debe ser llamada por BurstSMS cuando se reciben nuevos mensajes. Debe configurar esto para su número en las opciones de 'Configuración de entrada'. Seleccione 'Sí' en la opción 'Reenviar a URL' e ingrese esta URL."

msgid "DLR callback URL"
msgstr "Callback URL de DLR"

msgid "This URL should be called by BurstSMS when the status of an outgoing message is updated. You can set it on the settings page."
msgstr "Esta URL debe ser llamada por BurstSMS cuando se actualiza el estado de un mensaje saliente. Puede configurarlo en su página de configuración."

msgid "Reply callback URL"
msgstr "Callback URL de respuesta"

msgid "This URL should be called by BurstSMS when messages are replied to. You can set it on the settings page."
msgstr "BurstSMS debe llamar a esta URL cuando se responda a los mensajes. Puede configurarla en su página de configuración."

msgid "If you're based in the Philippines, you can integrate with Chikka to send and receive messages on your short code."
msgstr "Si reside en Filipinas, puede integrarse con Chikka para enviar y recibir mensajes en su código corto."

msgid "To finish configuring your Chikka connection, you'll need to set the following URLs in your Chikka account API settings."
msgstr "Para terminar de configurar su conexión de Chikka, debe establecer las siguientes URL en la configuración de la API de su cuenta de Chikka."

msgid "Notification receiver URL"
msgstr "URL del receptor de notificaciones"

msgid "Message receiver URL"
msgstr "URL del receptor de mensajes"

